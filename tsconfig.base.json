{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@movie/core": ["packages/core/src/index.ts"],
      "@movie/schemas": ["packages/schemas/src/index.ts"],
      "@movie/api-client": ["packages/api-client/src/index.ts"]
    }
  }
}
