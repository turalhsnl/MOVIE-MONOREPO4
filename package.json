{
  "name": "movie-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:web": "pnpm --filter @movie/web dev",
    "dev:mobile": "pnpm --filter @movie/mobile start",
